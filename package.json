{
  "name": "watchlist",
  "version": "1.0.0",
  "description": "Checks the availability of movies and shows from your Trakt.tv watchlist on Netflix and Prime Video.",
  "main": "index.js",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build-ui": "DISABLE_ESLINT_PLUGIN=true vite build frontend --outDir ../build --emptyOutDir",
    "start": "pnpm exec sequelize-cli db:migrate && node index.js",
    "dev": "pnpm exec sequelize-cli db:migrate && nodemon --legacy-watch index.js",
    "start-dev": "DEBUG=watchlist:* BROWSER=none REACT_DEV_SERVER=true TUNNEL=true WATCH=true pnpm run start",
    "migrate": "pnpm exec sequelize-cli db:migrate",
    "lint": "pnpm exec eslint migrations/**/*.js api/**/*.js models/**/*.js receiver/**/*.js index.js",
    "test": "jest",
    "streaming:manifest": "node scripts/gen-streaming-manifest.js"
  },
  "dependencies": {
    "@devicefarmer/adbkit": "^3.3.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@ngrok/ngrok": "^1.7.0",
    "@sentry/node": "^10.75.3",
    "@tanstack/react-query": "^5.103.2",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "connect-ensure-login": "^0.1.1",
    "connect-session-sequelize": "^8.0.6",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-singleflight": "^0.1.3",
    "passport": "^0.7.0",
    "passport-access-token": "^1.0.3",
    "passport-trakt": "^1.0.4",
    "promise-streams": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-player": "3.4.0",
    "react-router-dom": "^7.18.4",
    "react-swipeable": "^7.0.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "streaming-availability": "^4.5.0",
    "trakt.tv": "^8.2.0",
    "trakt.tv-images": "^5.2.0",
    "trakt.tv-queued": "^3.0.0",
    "vite": "^8.3.1",
    "vite-express": "^0.22.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "babel-jest": "30.5.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "30.1.3",
    "nodemon": "^3.1.14"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "projects": [
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/api/**/*.test.js",
          "<rootDir>/receiver/**/*.test.js",
          "<rootDir>/models/**/*.test.js"
        ]
      },
      {
        "displayName": "frontend",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/frontend/**/*.test.jsx"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/frontend/src/setupTests.js"
        ],
        "transform": {
          "^.+\\.(js|jsx)$": "babel-jest"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(@mui|@babel|@emotion|react-player)/)"
        ]
      }
    ]
  }
}
